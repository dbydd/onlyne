{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spec",
  "description": "Cluster spec loaded from `<server-root>/.onlyne/spec.toml`.",
  "type": "object",
  "required": [
    "server"
  ],
  "properties": {
    "client": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/ClientEntry"
      }
    },
    "gateway": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/GatewayEntry"
      }
    },
    "hook": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/HookEntry"
      }
    },
    "route": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/RouteEntry"
      }
    },
    "server": {
      "$ref": "#/definitions/ServerSection"
    }
  },
  "definitions": {
    "ClientEntry": {
      "description": "`[[client]]` entry. Aggregate roles use the same struct and carry an annotation in `aggregate`.",
      "type": "object",
      "required": [
        "key",
        "role"
      ],
      "properties": {
        "admin": {
          "default": false,
          "type": "boolean"
        },
        "aggregate": {
          "default": "",
          "type": "string"
        },
        "allowed_senders": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_targets": {
          "description": "The roles this role may address. This is the server's ACL and nothing else: reach is permission, and permission never compels a delivery (`docs/v2-CONTRACT.md` §\"Slice 6\").",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intent": {
          "default": {
            "attempts": 3,
            "backoff_ms": [
              1000,
              2000,
              4000
            ]
          },
          "allOf": [
            {
              "$ref": "#/definitions/IntentPolicy"
            }
          ]
        },
        "key": {
          "type": "string"
        },
        "max_sessions": {
          "default": 1,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "owes_targets": {
          "description": "The roles a session of this role owes a delivery to before it may report a terminal outcome. The obligation is declared here, separately from reach, because reach is permission and permission is not a duty: a role that may address ten others does not owe all ten a handoff. Absent or empty is the default, and it owes nothing; every name must be addressable through `allowed_targets`, or the loader refuses the spec.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prose": {
          "default": "",
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "runtime": {
          "description": "The drive and the argv a session runs: `[client.runtime]`.",
          "default": {
            "command": [],
            "drive": "plugin"
          },
          "allOf": [
            {
              "$ref": "#/definitions/RuntimeSection"
            }
          ]
        },
        "timeout": {
          "default": {
            "idle_ms": 60000,
            "ready_ms": 30000
          },
          "allOf": [
            {
              "$ref": "#/definitions/Timeouts"
            }
          ]
        }
      }
    },
    "Drive": {
      "description": "How a client talks to one role's runtime: `[client.runtime] drive`.\n\nDrive is a property of the runtime and belongs in the spec. Where the runtime process is displayed is the placement, a property of the machine, and belongs in that role workspace's `config.toml` (`docs/v2-PLAN.md` §\"驱动与放置\").",
      "oneOf": [
        {
          "description": "The client starts the runtime and a plugin inside it dials back.",
          "type": "string",
          "enum": [
            "plugin"
          ]
        },
        {
          "description": "The client runs the agent as its own child and speaks the Agent Client Protocol on that child's stdio.",
          "type": "string",
          "enum": [
            "acp"
          ]
        },
        {
          "description": "The client runs the command and reads its exit code.",
          "type": "string",
          "enum": [
            "exec"
          ]
        }
      ]
    },
    "GatewayEntry": {
      "description": "`[[gateway]]` entry.",
      "type": "object",
      "required": [
        "id",
        "key",
        "platform"
      ],
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "HookEntry": {
      "description": "An event hook declaration: when an event of a class in `on` is persisted, run `run` with a timeout (`docs/v2-CONTRACT.md` §\"Slice 7\"). `on` names event classes from the closed set; a class not in the set is refused by name at load time. `run` is a command argv. `timeout` bounds the script and is required.",
      "type": "object",
      "required": [
        "on",
        "run",
        "timeout"
      ],
      "properties": {
        "on": {
          "description": "Event classes this hook fires for. Each must be one of the classes the server emits: the durable/advisory/settlement families.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "run": {
          "description": "Command to run; argv. The event JSON (including `seq`) is written to stdin, and `ONLYNE_SOCKET` points at the admin socket.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeout": {
          "description": "Timeout bounding the script, e.g. \"10s\", \"500ms\", \"2m\". Required.",
          "type": "string"
        }
      }
    },
    "IntentPolicy": {
      "description": "Intent retry policy for coding-agent responses.",
      "type": "object",
      "properties": {
        "attempts": {
          "default": 3,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "backoff_ms": {
          "default": [
            1000,
            2000,
            4000
          ],
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          }
        }
      }
    },
    "RouteEntry": {
      "description": "External inbound message route.",
      "type": "object",
      "required": [
        "channel",
        "gateway",
        "to"
      ],
      "properties": {
        "channel": {
          "type": "string"
        },
        "conversation": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "gateway": {
          "type": "string"
        },
        "to": {
          "$ref": "#/definitions/RouteTarget"
        }
      }
    },
    "RouteTarget": {
      "description": "Destination role and optional fixed session for a route.",
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "session": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "RuntimeSection": {
      "description": "`[client.runtime]` — the drive and the argv one session of this role runs.\n\nAn absent table is `drive = \"plugin\"` with an empty command, which is what every role in the tree is today.",
      "type": "object",
      "properties": {
        "command": {
          "description": "The argv one session runs. `{session}` and `{task}` are substituted by the client, and every other brace is refused. Absent means an empty list, which no drive can start a session with.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "drive": {
          "description": "`plugin` | `acp` | `exec`. Absent means [`Drive::Plugin`].",
          "default": "plugin",
          "allOf": [
            {
              "$ref": "#/definitions/Drive"
            }
          ]
        }
      }
    },
    "ServerSection": {
      "description": "`[server]` section for the cluster.",
      "type": "object",
      "required": [
        "cert_pin",
        "listen",
        "name"
      ],
      "properties": {
        "agent_package": {
          "default": "",
          "type": "string"
        },
        "cert_pin": {
          "type": "string"
        },
        "fault_history_days": {
          "default": 14,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "ghost_sweep_secs": {
          "description": "Scan interval in seconds for the ghost sweep, which settles a `working` session row whose own task ledger row already reached a terminal state. `0` disables the sweep.",
          "default": 60,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "heartbeat_grace_secs": {
          "default": 90,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "heartbeat_timeout_ms": {
          "default": 30000,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "listen": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "note_queue": {
          "default": false,
          "type": "boolean"
        },
        "requeue_max_attempts": {
          "description": "Cap on automatic in-flight requeues. `0` is unlimited. Crossing it settles the row as rejected with reason `requeue_exhausted`.",
          "default": 0,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "requeue_ttl_secs": {
          "description": "Age limit in seconds from `enqueued_at` for an automatic requeue. `0` leaves the gate off. Crossing it settles the row as expired with reason `requeue_ttl`.",
          "default": 0,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "resync_lag": {
          "default": 256,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "stale_watch_secs": {
          "default": 60,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "template_root": {
          "default": ".onlyne/templates",
          "type": "string"
        }
      }
    },
    "Timeouts": {
      "description": "Client timeout policy in milliseconds.",
      "type": "object",
      "properties": {
        "idle_ms": {
          "default": 60000,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "ready_ms": {
          "default": 30000,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    }
  }
}