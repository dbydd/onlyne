{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClientConfig",
  "description": "Client-side `<workspace>/.onlyne/config.toml`.",
  "type": "object",
  "required": [
    "cert_pin",
    "key_path",
    "role",
    "server"
  ],
  "properties": {
    "cert_pin": {
      "description": "Server certificate SPKI fingerprint.",
      "type": "string"
    },
    "key_path": {
      "description": "Path to this role's private key file.",
      "type": "string"
    },
    "orca": {
      "description": "Orca session backend settings.",
      "default": {
        "worktree": "auto"
      },
      "allOf": [
        {
          "$ref": "#/definitions/OrcaSection"
        }
      ]
    },
    "plugins": {
      "description": "Local plugin list.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "description": "Role name used for this workspace.",
      "type": "string"
    },
    "server": {
      "description": "Server endpoint.",
      "allOf": [
        {
          "$ref": "#/definitions/ServerEndpoint"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "OrcaSection": {
      "description": "`[orca]` — settings for the Orca session backend.",
      "type": "object",
      "properties": {
        "worktree": {
          "description": "Where a spawned terminal lands: `auto` (the default) registers the role workspace as an Orca folder on first use, `inherit` leaves the choice to Orca's active worktree, and any other value is used verbatim as an Orca worktree selector (`path:<abs>`, `id:<…>`, `name:<…>`, `branch:<…>`).",
          "default": "auto",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ServerEndpoint": {
      "description": "Server host and port pair used by the client.",
      "type": "object",
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "description": "Hostname or address, possibly a `$NAME` env reference.",
          "type": "string"
        },
        "port": {
          "description": "TCP port.",
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    }
  }
}