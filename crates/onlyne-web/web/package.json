    "elkjs": "^0.10.0",
    "json-schema-to-typescript": "^15.0.4",
    "phosphor-svelte": "^3.1.0",
    "svelte": "^5.39.5",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
