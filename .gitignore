target*
.omx
# Root agent state is local. Archived role templates remain trackable.
/.pi/
/.pi*/
# Runtime Onlyne trees stay out of the index: <server-root>/.onlyne/ and <workspace>/.onlyne/.
.onlyne/
# omp's own agent state at the repository root (memory, receipts).
/.omp/
# Archived role templates include versioned client configuration fragments.
!**/templates/**/.onlyne/
__pycache__/
*.pyc
# Runtime trees of the in-repo examples (server roots and generated workspaces).
examples/*/cluster/
archive/examples/*/cluster/
archive/.pi/
archive/.omp/
# Operator credentials for the IM gateway example: filled in locally, never
# committed. `.env.example` beside `.env` is the tracked template.
.env
node_modules/
dist/
# `npm pack` output, kept out of the index so a release tarball never becomes a source file.
*.tgz
# Integration checkouts for other projects live outside this repository's history; each becomes
# its own repository.
/external-integrations/
