{
  "name": "@onlyne/desktop-bot",
  "version": "3.1.0",
  "description": "Extensible Onlyne desktop bot teams driven by OMP RPC",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/dbydd/onlyne.git", "directory": "packages/desktop-bot" },
  "publishConfig": { "access": "public" },
  "engines": { "bun": ">=1.4.3" },
  "exports": { ".": "./src/index.ts", "./contracts": "./src/contracts.ts", "./ui": "./src/ui/api.ts" },
  "bin": { "onlyne-desktop": "src/launch.ts" },
  "files": ["src", "README.md", "LICENSE"],
  "scripts": { "check": "tsc --noEmit", "test": "bun tests/verify.ts", "start": "bun src/launch.ts", "serve": "bun src/main.ts --serve", "demo": "bun src/main.ts --serve --demo --port 4173" },
  "dependencies": {
    "@onlyne/lib": "^3.1.0",
    "@onlyne/node-host": "^3.1.0",
    "@onlyne/im-gateway": "^3.1.0",
    "electron": "45.2.2"
  },
  "trustedDependencies": ["electron"],
  "devDependencies": { "@types/bun": "^1.3.0", "typescript": "^5.9.0" }
}
