{
  "name": "@onlyne/im-gateway",
  "version": "3.2.0",
  "description": "Onlyne IM gateway: one node that hosts platform conversations as resources and pushes events to their handlers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbydd/onlyne.git",
    "directory": "packages/im-gateway"
  },
  "homepage": "https://github.com/dbydd/onlyne#readme",
  "bugs": "https://github.com/dbydd/onlyne/issues",
  "keywords": ["onlyne", "im", "gateway", "cli"],
  "publishConfig": { "access": "public" },
  "engines": { "bun": ">=1.4.3" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    }
  },
  "bin": {
    "onlyne-im-gateway": "dist/main.js",
    "onlyne-im-migrate": "dist/migrate-main.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "check": "tsc && tsc -p tsconfig.tests.json",
    "test": "bun tests/verify.ts && bun tests/channels.ts && bun tests/migration.ts && bun tests/observability.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@onlyne/im-core": "^3.2.0",
    "@onlyne/im-fake": "^3.2.0",
    "@onlyne/lib": "^3.2.0",
    "@onlyne/node-host": "^3.2.0"
  },
  "peerDependencies": {
    "@onlyne/im-lark": "^3.2.0",
    "@onlyne/im-qq": "^3.2.0",
    "@onlyne/im-wechat": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "@onlyne/im-lark": { "optional": true },
    "@onlyne/im-qq": { "optional": true },
    "@onlyne/im-wechat": { "optional": true }
  },
  "devDependencies": {
    "@onlyne/im-lark": "^3.2.0",
    "@onlyne/im-qq": "^3.2.0",
    "@onlyne/im-wechat": "^3.2.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
