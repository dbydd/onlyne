{
  "name": "@onlyne/im-gateway",
  "version": "3.0.0",
  "description": "Onlyne IM gateway: one node that hosts platform conversations as resources and pushes events to their handlers",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbydd/onlyne.git",
    "directory": "packages/im-gateway"
  },
  "homepage": "https://github.com/dbydd/onlyne#readme",
  "bugs": "https://github.com/dbydd/onlyne/issues",
  "keywords": ["onlyne", "im", "gateway", "cli"],
  "publishConfig": { "access": "public" },
  "engines": { "bun": ">=1.4.3" },
  "exports": {
    ".": "./src/index.ts",
    "./storage": "./src/storage.ts",
    "./migrate": "./src/migrate.ts"
  },
  "bin": {
    "onlyne-im-gateway": "src/main.ts",
    "onlyne-im-migrate": "src/migrate-main.ts"
  },
  "files": ["src", "README.md", "LICENSE"],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun tests/verify.ts && bun tests/channels.ts && bun tests/migration.ts"
  },
  "dependencies": {
    "@onlyne/im-core": "^3.0.0",
    "@onlyne/im-fake": "^3.0.0",
    "@onlyne/lib": "^3.0.0",
    "@onlyne/node-host": "^3.0.0"
  },
  "peerDependencies": {
    "@onlyne/im-lark": "^3.0.0",
    "@onlyne/im-qq": "^3.0.0",
    "@onlyne/im-wechat": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@onlyne/im-lark": { "optional": true },
    "@onlyne/im-qq": { "optional": true },
    "@onlyne/im-wechat": { "optional": true }
  },
  "devDependencies": {
    "@onlyne/im-lark": "^3.0.0",
    "@onlyne/im-qq": "^3.0.0",
    "@onlyne/im-wechat": "^3.0.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
