{
  "name": "@onlyne/compute-gateway",
  "version": "3.2.0",
  "description": "Onlyne compute broker gateway: standalone node managing elastic sandbox container leases, safety net sweeps, and direct data-plane credentials",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbydd/onlyne.git",
    "directory": "packages/compute-gateway"
  },
  "homepage": "https://github.com/dbydd/onlyne#readme",
  "bugs": "https://github.com/dbydd/onlyne/issues",
  "keywords": ["onlyne", "compute", "broker", "gateway", "sandbox"],
  "publishConfig": { "access": "public" },
  "engines": { "bun": ">=1.4.3" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": { "onlyne-compute-broker": "dist/main.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "check": "tsc && tsc -p tsconfig.tests.json",
    "test": "bun tests/verify.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@onlyne/compute-core": "^3.2.0",
    "@onlyne/lib": "^3.2.0",
    "@onlyne/node-host": "^3.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
