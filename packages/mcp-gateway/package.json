{
  "name": "@onlyne/mcp-gateway",
  "version": "3.1.0",
  "description": "Onlyne MCP gateway: one node that hosts MCP servers as resources and exposes their tools as operations",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbydd/onlyne.git",
    "directory": "packages/mcp-gateway"
  },
  "homepage": "https://github.com/dbydd/onlyne#readme",
  "bugs": "https://github.com/dbydd/onlyne/issues",
  "keywords": ["onlyne", "mcp", "gateway", "cli"],
  "publishConfig": { "access": "public" },
  "engines": { "bun": ">=1.4.3" },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": { "onlyne-mcp-gateway": "src/main.ts" },
  "files": ["src", "README.md", "LICENSE"],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun tests/verify.ts && bun tests/mounts-verify.ts",
    "smoke": "bun tests/mounts-smoke.ts",
    "smoke:fast": "MOUNT_SMOKE_INTERVAL_MS=3000 bun tests/mounts-smoke.ts"
  },
  "dependencies": {
    "@onlyne/im-gateway": "^3.1.0",
    "@onlyne/lib": "^3.1.0",
    "@onlyne/mcp-core": "^3.1.0",
    "@onlyne/node-host": "^3.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
