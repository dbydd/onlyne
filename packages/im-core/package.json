{
  "name": "@onlyne/im-core",
  "version": "3.2.0",
  "description": "IM connector contracts and the driver bridge that turns platform events into Onlyne resources",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbydd/onlyne.git",
    "directory": "packages/im-core"
  },
  "homepage": "https://github.com/dbydd/onlyne#readme",
  "bugs": "https://github.com/dbydd/onlyne/issues",
  "keywords": ["onlyne", "im", "connector", "resource"],
  "publishConfig": { "access": "public" },
  "engines": { "bun": ">=1.4.3" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "check": "tsc && tsc -p tsconfig.tests.json",
    "test": "bun tests/verify.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@onlyne/lib": "^3.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
