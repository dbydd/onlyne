{
  "name": "@onlyne/grok-bot",
  "version": "3.2.0",
  "description": "Onlyne communication node for Grok Bot: inbound messages POST to a configured webhook",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbydd/onlyne.git",
    "directory": "packages/grok-bot"
  },
  "homepage": "https://github.com/dbydd/onlyne#readme",
  "bugs": "https://github.com/dbydd/onlyne/issues",
  "keywords": ["onlyne", "grok", "webhook", "gateway", "cli"],
  "publishConfig": { "access": "public" },
  "engines": { "bun": ">=1.4.3" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": { "onlyne-grok-bot": "dist/main.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "check": "tsc && tsc -p tsconfig.tests.json",
    "test": "bun tests/verify.ts && bun tests/http.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@onlyne/im-gateway": "^3.2.0",
    "@onlyne/lib": "^3.2.0",
    "@onlyne/node-host": "^3.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
